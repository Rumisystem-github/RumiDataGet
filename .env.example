# このファイルをコピーして「.env」という名前で置き、値を書き換えて使う
# （.env自体はGit管理対象外）

# データベース接続URL（必須）
DATABASE_URL=mysql://user:password@host:3306/dbname

# 待ち受けアドレス（任意、デフォルトは 0.0.0.0:3007）
#BIND_ADDR=0.0.0.0:3007

# ファイル実体の置き場所（任意、デフォルトは /mnt/DATA/RDS）
#DATA_DIR=/mnt/DATA/RDS

# ファイルID解決キャッシュの保持秒数（任意、デフォルトは30。0で無効）
#CACHE_TTL_SEC=30

# DB接続プールの最大接続数（任意、デフォルトは20）
#DB_MAX_CONNECTIONS=20

# DB接続の取得タイムアウト秒数（任意、デフォルトは10）
#DB_ACQUIRE_TIMEOUT_SEC=10

# DBクエリのタイムアウト秒数（任意、デフォルトは5。0で無効）
#DB_QUERY_TIMEOUT_SEC=5

